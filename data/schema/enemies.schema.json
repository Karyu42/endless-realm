{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endless-realm.local/schema/enemies.schema.json",
  "title": "Endless Realm enemies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enemies"
  ],
  "properties": {
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "name",
              "rank",
              "base",
              "move_speed",
              "radius",
              "aggro_radius",
              "ai"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "string",
                "enum": [
                  "normal",
                  "elite",
                  "boss"
                ]
              },
              "base": {
                "type": "object",
                "required": [
                  "hp",
                  "ward",
                  "contact",
                  "damage"
                ],
                "additionalProperties": false,
                "properties": {
                  "hp": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "ward": {
                    "type": "number",
                    "minimum": 0
                  },
                  "contact": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "damage": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "move_speed": {
                "type": "number",
                "minimum": 0
              },
              "wander_speed": {
                "type": "number",
                "minimum": 0
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "aggro_radius": {
                "type": "number",
                "minimum": 0
              },
              "hover_radius": {
                "type": "number",
                "minimum": 0
              },
              "leash": {
                "type": "number",
                "minimum": 0
              },
              "strafe_switch_ticks": {
                "type": "integer",
                "minimum": 1
              },
              "ai": {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "chase_hover",
                      "rooted"
                    ]
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "fire_interval_ticks": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "id": {
                  "const": "driftcap_spore"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "required": [
                "move_speed",
                "radius",
                "aggro_radius",
                "ai"
              ],
              "properties": {
                "ai": {
                  "type": "object",
                  "required": [
                    "type",
                    "pattern",
                    "fire_interval_ticks"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
