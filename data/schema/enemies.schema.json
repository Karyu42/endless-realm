{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endless-realm.local/schema/enemies.schema.json",
  "title": "Endless Realm enemies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enemies"
  ],
  "properties": {
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "name",
              "rank",
              "base",
              "move_speed",
              "radius",
              "aggro_radius",
              "ai"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "string",
                "enum": [
                  "normal",
                  "elite",
                  "boss"
                ]
              },
              "base": {
                "type": "object",
                "required": [
                  "hp",
                  "ward",
                  "contact",
                  "damage"
                ],
                "additionalProperties": false,
                "properties": {
                  "hp": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "ward": {
                    "type": "number",
                    "minimum": 0
                  },
                  "contact": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "damage": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "move_speed": {
                "type": "number",
                "minimum": 0
              },
              "wander_speed": {
                "type": "number",
                "minimum": 0
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "aggro_radius": {
                "type": "number",
                "minimum": 0
              },
              "deaggro_radius": {
                "type": "number",
                "minimum": 0
              },
              "no_leash": {
                "type": "boolean"
              },
              "hover_radius": {
                "type": "number",
                "minimum": 0
              },
              "leash": {
                "type": "number",
                "minimum": 0
              },
              "strafe_switch_ticks": {
                "type": "integer",
                "minimum": 1
              },
              "ai": {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "chase_hover",
                      "rooted",
                      "boss"
                    ]
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "fire_interval_ticks": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "alt_pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt_every_cycles": {
                    "type": "integer",
                    "minimum": 2
                  },
                  "sidestep_tiles": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "sidestep_interval_ticks": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sidestep_duration_ticks": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "party_scaling": {
                "type": "string",
                "enum": [
                  "normal",
                  "boss"
                ]
              },
              "target_rule": {
                "type": "string",
                "enum": [
                  "living_in_arena"
                ]
              },
              "phases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/phase"
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "id": {
                  "const": "driftcap_spore"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "required": [
                "move_speed",
                "radius",
                "aggro_radius",
                "ai"
              ],
              "properties": {
                "ai": {
                  "type": "object",
                  "required": [
                    "type",
                    "pattern",
                    "fire_interval_ticks"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "rank": {
                  "const": "boss"
                }
              },
              "required": [
                "rank"
              ]
            },
            "then": {
              "required": [
                "phases",
                "party_scaling"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hp_above": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transition": {
          "type": "boolean"
        },
        "ticks": {
          "type": "integer",
          "minimum": 1
        },
        "invulnerable": {
          "type": "boolean"
        },
        "move_speed": {
          "type": "number",
          "minimum": 0
        },
        "move": {
          "type": "string",
          "enum": [
            "drift_center",
            "anchor_center"
          ]
        },
        "move_to": {
          "type": "string",
          "enum": [
            "center"
          ]
        },
        "loop_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase_loop"
          }
        },
        "on_enter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase_enter_action"
          }
        },
        "enrage": {
          "$ref": "#/$defs/enrage"
        }
      }
    },
    "phase_loop": {
      "type": "object",
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "every_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "offset_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "window_start_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "window_end_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "at_loop_start": {
          "type": "boolean"
        },
        "once_per_loop": {
          "type": "boolean"
        }
      }
    },
    "phase_enter_action": {
      "type": "object",
      "required": [
        "summon",
        "at",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "summon": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "enum": [
            "corners"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "loot": {
          "type": "boolean"
        }
      }
    },
    "enrage": {
      "type": "object",
      "required": [
        "timer_start",
        "after_ticks",
        "interval_mult"
      ],
      "additionalProperties": false,
      "properties": {
        "timer_start": {
          "type": "string",
          "enum": [
            "seal"
          ]
        },
        "after_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "interval_mult": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
