{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endless-realm.local/schema/classes.schema.json",
  "title": "Endless Realm classes",
  "type": "object",
  "additionalProperties": false,
  "required": ["classes"],
  "properties": {
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "base_hp", "base_ward", "stride", "tempo", "weapon_id", "ability_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "base_hp": { "type": "integer", "minimum": 1 },
          "base_ward": { "type": "number", "minimum": 0 },
          "stride": { "type": "number", "minimum": 0 },
          "tempo": { "type": "number", "minimum": 0 },
          "focus": { "type": "integer", "minimum": 0 },
          "focus_regen": { "type": "number", "minimum": 0 },
          "weapon_id": { "type": "string" },
          "ability_id": { "type": "string" }
        }
      }
    }
  }
}
