{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endless-realm.local/schema/patterns.schema.json",
  "title": "Endless Realm bullet patterns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patterns"
  ],
  "properties": {
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "required": [
        "id",
        "type",
        "speed",
        "range",
        "size",
        "damage_key",
        "trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "fan",
            "ring"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "spread_deg": {
          "type": "number"
        },
        "aim": {
          "type": "string",
          "enum": [
            "aimed",
            "fixed",
            "heading"
          ]
        },
        "start_angle_deg": {
          "type": "number"
        },
        "rotate_per_fire_deg": {
          "type": "number"
        },
        "angle_offset_cycle_deg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "skip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consecutive",
            "start"
          ],
          "properties": {
            "consecutive": {
              "type": "integer",
              "minimum": 0
            },
            "start": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "const": "rng"
                }
              ]
            }
          }
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size": {
          "type": "string",
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "damage_key": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "timer",
            "ai_step",
            "on_death",
            "phase_enter"
          ]
        },
        "interval_ticks": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
