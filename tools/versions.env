# Pinned toolchain versions for Endless Realm.
# Source of truth for Makefile and docker compose. Do not float tags.

# Server language / CI toolchain
GO_VERSION=1.27.4

# Protobuf compiler and Go plugin (used by `make proto`)
PROTOC_VERSION=36.2
PROTOC_GEN_GO_VERSION=v1.36.12

# Client protobuf codegen (not installed by this repo yet).
# Latest published release is v0.7.0, documented for Godot 4.6;
# the client is Godot 4.7.2-stable — confirm compatibility in the client PR.
GODOBUF_VERSION=v0.7.0

# Dev-only Postgres; the server does not connect to it in this skeleton.
POSTGRES_IMAGE=postgres:18.7-alpine3.24
